# test all patterns of ./configure and make

disable_all="--disable-filer\
 --disable-history\
 --disable-undo\
 --disable-nls\
 --disable-syntax\
 --disable-rc\
 --disable-regex\
 --disable-help\
 --disable-debug\
 --disable-ncurses\
 --disable-pcre\
 --disable-nkf\
 --disable-busybox\
 --disable-highbgc"

cmd_line_00="./configure"
cmd_line_01="./configure --enable-all"
cmd_line_02="./configure --disable-all"
cmd_line_03="./configure --disable-filer"
cmd_line_04="./configure --disable-history"
cmd_line_05="./configure --disable-undo"
cmd_line_06="./configure --disable-nls"
cmd_line_07="./configure --disable-syntax"
cmd_line_08="./configure --disable-syntax --disable-rc"
cmd_line_09="./configure --disable-syntax --disable-regex"
cmd_line_10="./configure --disable-syntax --disable-rc --disable-regex"
cmd_line_11="./configure --disable-nkf"
cmd_line_12="./configure --disable-highbgc"
cmd_line_13="./configure --disable-help"
cmd_line_14="./configure --enable-ncurses"
cmd_line_15="./configure --enable-ncurses --enable-highbgc"
cmd_line_16="./configure --enable-pcre"
cmd_line_17="./configure --enable-debug"
cmd_line_18="./configure $disable_all --enable-filer"
cmd_line_19="./configure $disable_all --enable-debug"
cmd_line_20="./configure $disable_all --enable-filer --enable-busybox"

echo_run()
{
  echo ""
  echo "ConfigurationNo.: $conf_num, SizeOfExecutableFile ======================"
  echo "Running: $cmd_line"
  $cmd_line
  make clean
  echo "ConfigurationNo.: " $conf_num
  make
  echo "ConfigurationNo.: " $conf_num
  strip be
  ./be -v
  echo "Summary - ConfigurationNo.: " $conf_num "------------------------------"
  echo "Summary - Running: $cmd_line"
  echo -n "Summary - SizeOfExecutableFile: "; ls -l be
  if [ ! -f be ]; then
    echo "BuildError !!!!"
    exit -1
  fi
##  echo "Summary -----------------------------------------------------"
}

if [ "$1" = "-" ]; then
  while : ; do
    grep Summary _conf_make_all_patterns.log
    grep complete _conf_make_all_patterns.log
    if [ "$?" = 0 ]; then
      exit
    fi
    sleep 5
  done
fi

start_num=0
if [ -n "$1" ]; then
  start_num="$1"
fi

rm -f _conf_make_all_patterns.log

{
  echo "----conf_make_all_patterns-start----"
  for conf_num in $( seq -f %02.0f $start_num 20 ) ; do
    cmd_line_xx="cmd_line_$conf_num"
    eval "cmd_line=\$$cmd_line_xx" 2>&1
    echo_run $cmd_line 2>&1
  done
  echo "======================"
  if [ -z "$1" ]; then
    ./_c_debug
  fi
  echo "----conf_make_all_patterns-complete----"
} | tee _conf_make_all_patterns.log

grep "Summary" _conf_make_all_patterns.log >__error
cat __error | tee -a _conf_make_all_patterns.log
cp -auv _conf_make_all_patterns.log _conf_make_all_patterns.latest
