# configure in only enable 'busybox'
# make, make install
LANG=C; export LANG
#sudo chown `whoami` *
echo "## ./configure ##" >>_conf.log
./configure --enable-busybox \
 --disable-undo \
 --disable-regex \
 --disable-syntax \
 --disable-rc \
 --disable-nls \
 --disable-nkf \
 --disable-help \
 --disable-highbgc \
 2>&1 | tee -a _conf.log

echo "#### End of ./configure ####" >>_conf.log
